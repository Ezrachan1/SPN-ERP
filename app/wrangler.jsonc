{
	// SPN ERP: Cloudflare Worker serving the SPA + JSON API on a D1 database.
	// 1) npx wrangler d1 create spn-erp
	// 2) paste the returned database_id below
	// 3) npx wrangler deploy
	// First visit walks you through creating the Super User account.
	"name": "spn-erp",
	"main": "src/worker.js",
	"compatibility_date": "2026-01-01",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "SPN_DB",
			"database_name": "spn-erp",
			"database_id": "47459544-37a9-4b6b-841e-62a9fc105c8e"
		},
		{
			"binding": "spn_erp",
			"database_name": "spn-erp",
			"database_id": "47459544-37a9-4b6b-841e-62a9fc105c8e"
		}
	],
	// Email invitations: the app can send invitation emails itself once a
	// sending domain is onboarded on your Cloudflare account:
	//   1) npx wrangler email sending enable yourdomain.com   (needs a domain on Cloudflare)
	//   2) set EMAIL_FROM below to an address on that domain, e.g. invites@yourdomain.com
	//   3) npx wrangler deploy
	// Until EMAIL_FROM is set, invitations fall back to a shareable link.
	"send_email": [
		{
			"name": "SPN_EMAIL"
		}
	],
	// Binary files (livestock photos, profile photos, SPN OS APK releases) can live
	// in R2. R2 must first be enabled on the Cloudflare account (Dashboard -> R2
	// Object Storage -> Enable; it asks for a payment method even for the free
	// 10 GB tier), otherwise the deploy fails with API error 10042. Until then the
	// Worker runs without it: images are stored in D1 and APK uploads report
	// "storage not configured". To switch R2 on:
	//   1) enable R2 in the dashboard
	//   2) npx wrangler r2 bucket create spn-erp-files
	//   3) uncomment the block below (binding name SPN_FILES must stay as is), push/deploy
	// "r2_buckets": [
	// 	{ "binding": "SPN_FILES", "bucket_name": "spn-erp-files" }
	// ],
	"vars": {
		"EMAIL_FROM": "",
		"EMAIL_FROM_NAME": "",
		// Extra origins allowed to call the API cross-origin (comma separated), e.g.
		// a custom scheme for the mobile app. Capacitor defaults are always allowed.
		"ALLOWED_ORIGINS": ""
	},
	"r2_buckets": [
		{
			"bucket_name": "spn-erp-files",
			"binding": "spn_erp_files",
			"remote": true
		}
	]
}